<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="search_template_milk_supplier">
            <button type="button" class="o-no-caret btn btn-secondary dropdown-toggle" data-toggle="dropdown">
                <span class="fa fa-filter"/>
                Milk Supplier:
                <t t-set="ms_value" t-value="'All'"/>
                <t t-foreach="options['milk_supplier_ops']" t-as="mso">
                    <t t-if="mso.get('selected') == True">
                        <t t-set="ms_value" t-value="''"/>
                        <t t-esc="mso.get('name')"/>
                    </t>
                </t>
                <t t-esc="ms_value"/>
                <span class="caret"/>
            </button>
            <div class="dropdown-menu o_filters_menu" role="menu">
                <t t-foreach="options['milk_supplier_ops']" t-as="mso">
                    <a role="menuitem" class="dropdown-item js_account_report_choice_filter"
                       t-att-title="mso.get('name')" t-att-data-id="mso.get('id')" data-filter="milk_supplier_ops">
                        <t t-esc="mso.get('name')"/>
                    </a>
                </t>
            </div>
        </template>

        <template id="search_template_inherit" inherit_id="account_reports.search_template">
            <xpath expr="//div[hasclass('o_account_reports_filter_analytic')]" position="after">
                <div class="btn-group o_dropdown o_account_reports_filter_milk_supplier"
                     t-if="options.get('milk_supplier') != None">
                    <t t-call="ejaf_account_reports_customization.search_template_milk_supplier"/>
                </div>
            </xpath>
        </template>

    </data>
</odoo>