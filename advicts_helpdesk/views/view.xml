<odoo>
    <data> 
        <record id="view_task_type_form_inherit" model="ir.ui.view">
            <field name="name">project.task.type.form.inherit</field>
            <field name="model">project.task.type</field>
            <field name="inherit_id" ref="project.project_task_type_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sequence']" position="after">
                    <field name="is_finished"/>
                </xpath>
            </field>
        </record>
 
        <record id="view_task_type_tree_inherit" model="ir.ui.view">
            <field name="name">project.task.type.tree.inherit</field>
            <field name="model">project.task.type</field>
            <field name="inherit_id" ref="project.project_task_type_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <field name="is_finished" widget="boolean_toggle" options="{'terminology': 'finished'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
