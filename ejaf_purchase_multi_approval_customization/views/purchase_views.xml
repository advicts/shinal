<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--multi approval-->
        <record id="purchase_order_form_inherit_multi_approval" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="ejaf_purchase_multi_approval.purchase_order_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='last_approved_level_id']" position="replace"/>

                <xpath expr="//field[@name='next_approval_level_id']" position="before">
                    <field name="last_approved_level_id" class="badge badge-info" attrs="{'invisible': ['|', ('last_approved_level_id', '=', False), ('multi_approval', '=', False)]}" options='{"no_open": True}' readonly="1" force_save="1"/>
                </xpath>

                <xpath expr="//button[@id='multi_approval']" position="attributes">
                    <attribute name="string">Next Action</attribute>
                </xpath>

                <xpath expr="//button[@id='limit_approval']" position="attributes">
                    <attribute name="string">Next Action</attribute>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_tree_inherit_multi_approval" model="ir.ui.view">
            <field name="name">purchase.order.tree.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="ejaf_purchase_multi_approval.purchase_order_tree_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='next_approval_level_id']" position="before">
                    <field name="last_approved_level_id" class="badge badge-info"
                           attrs="{'invisible': ['|', ('last_approved_level_id', '=', False), ('multi_approval', '=', False)]}"
                           options='{"no_open": True}' groups="ejaf_purchase_multi_approval.group_po_multi_approval_level" readonly="1" force_save="1"/>
                </xpath>

                <xpath expr="//field[@name='next_approval_level_id']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('next_approval_level_id', '=', False), ('multi_approval', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_view_tree_inherit_multi_approval" model="ir.ui.view">
            <field name="name">purchase.order.tree.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="ejaf_purchase_multi_approval.purchase_order_view_tree_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='next_approval_level_id']" position="before">
                    <field name="last_approved_level_id" class="badge badge-info"
                           attrs="{'invisible': ['|', ('last_approved_level_id', '=', False), ('multi_approval', '=', False)]}"
                           options='{"no_open": True}' groups="ejaf_purchase_multi_approval.group_po_multi_approval_level" readonly="1" force_save="1"/>
                </xpath>

                <xpath expr="//field[@name='next_approval_level_id']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('next_approval_level_id', '=', False), ('multi_approval', '=', False)]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_kpis_tree_inherit_multi_approval" model="ir.ui.view">
            <field name="name">purchase.order.tree.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="multi_approval" invisible="1"/>
                    <field name="last_approved_level_id" class="badge badge-info"
                           attrs="{'invisible': ['|', ('last_approved_level_id', '=', False), ('multi_approval', '=', False)]}"
                           options='{"no_open": True}' groups="ejaf_purchase_multi_approval.group_po_multi_approval_level" readonly="1" force_save="1"/>
                    <field name="next_approval_level_id"
                           class="badge badge-info"
                           attrs="{'invisible': ['|', ('next_approval_level_id', '=', False), ('multi_approval', '=', False)]}"
                           options='{"no_open": True}' groups="ejaf_purchase_multi_approval.group_po_multi_approval_level"/>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_ref']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', 'not in', ('draft', 'sent'))]}</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', 'not in', ('draft', 'sent'))]}</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('invoice_status','=', 'invoiced'), ('state', 'not in', ('draft', 'sent'))]}</attribute>
                </xpath>
                <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                    <attribute name="attrs">{'readonly': ['|', ('invoice_status','=', 'invoiced'), ('state', 'not in', ('draft', 'sent'))]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_stock_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.stock.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='incoterm_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', 'not in', ('draft', 'sent'))]}</attribute>
                </xpath>
                <xpath expr="//field[@name='dest_address_id']" position="attributes">
                    <attribute name="attrs">{'invisible': [('default_location_dest_id_usage', '!=', 'customer')], 'required': [('default_location_dest_id_usage', '=', 'customer')], 'readonly': ['|', ('invoice_status','=', 'invoiced'), ('state', 'not in', ('draft', 'sent'))]}</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
