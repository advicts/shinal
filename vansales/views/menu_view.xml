            <iframe
              src="http://istarkov.github.io/google-map-clustering-example/"
              width="100%"
              height="100%"
              style="position:absolute; left:0; top:0; width:100%; height:100%;border-width:0px;"
              marginwidth="0"
              marginheight="0"
              frameborder="no"
              scrolling="no"
            />
          </div>
        </form>
      </field>
    </record>
