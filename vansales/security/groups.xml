<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vansales_category" model="ir.module.category">
            <field name="name">VanSales</field>
            <field name="sequence" eval="1"/>
        </record>
        <record id="vansale_user_group" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="vansales.vansales_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="vansale_admin_group" model="res.groups">
            <field name="name"> Admin</field>
            <field name="category_id" ref="vansales.vansales_category"/>
            <field name="implied_ids" eval="[(4, ref('vansales.vansale_user_group'))]"/>
        </record>


    </data>
</odoo>