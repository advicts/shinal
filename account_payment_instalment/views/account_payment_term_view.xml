<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_term_form_instalment" model="ir.ui.view">
            <field name="name">account.payment.term.form.instalment</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/list/field[@name='delay_type']" position="after">
                    <field name="period_type"/>
                    <field name="period_count"/>
                </xpath>

<!--                <field name="line_ids" position="attributes">-->
<!--                    <attribute name="form_view_ref">your_custom_line_form_view</attribute>-->
<!--                </field>-->
            </field>
        </record>
<!--                <record id="view_payment_term_form_instalment" model="ir.ui.view">-->
<!--            <field name="name">account.payment.term.form</field>-->
<!--            <field name="model">account.payment.term</field>-->
<!--            <field name="inherit_id" ref="account.view_payment_term_form"/>-->
<!--            <field name="arch" type="xml">-->
<!--                <p class="text-muted" position="replace">-->
<!--                    The last line's computation type should be "Balance or Instalment" to ensure that the whole amount will be allocated.-->
<!--                </p>-->
<!--            </field>-->
<!--        </record>-->
        <record id="view_payment_term_line_custom_form" model="ir.ui.view">
            <field name="name">account.payment.term.line.custom.form</field>
            <field name="model">account.payment.term.line</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="value_amount"/>
                            <field name="value"/>
                            <field name="nb_days" invisible="('value', '=', 'instalment')"/>
                            <field name="delay_type" invisible="('value', '=', 'instalment')"/>
                        </group>
                        <group>
                            <field name="period_type" required="('value', '=', 'instalment')"
                                   invisible="1" column_invisible="1"/>
                            <field name="period_count" required="('value', '=', 'instalment')"
                                   invisible="1" column_invisible="1"/>
                            <group invisible="('value', '!=', 'instalment')">
                                <field name="period_type"/>
                                <field name="period_count"/>
                            </group>
                        </group>
                    </group>
                </form>
            </field>
        </record>
    </data>
</odoo>