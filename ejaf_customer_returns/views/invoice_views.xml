<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_invoice_lines" type="object"
                            icon="fa-dollar" string="Customer Invoice lines"
                            attrs="{'invisible':[('picking_created_from','=', False)]}"/>
                </xpath>
                <xpath expr="//field[@name='is_move_sent']" position="after">
                    <field name="picking_created_from" invisible="1"/>
                </xpath>
                <xpath expr="//page[last()]" position="after">
                    <page string="Products Price Average" attrs="{'invisible':[('picking_created_from','=', False)]}">
                        <field name="product_avg_price_ids">
                            <tree editable="bottom" readonly="True">
                                <field name="product_id"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="sale_price" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="customer_invoice_line_tree" model="ir.ui.view">
            <field name="name">account.move.line</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="product_id"/>
                    <field name="move_id" string="Invoice"/>
                    <field name="price_unit" string="Sale Price" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                    <field name="date"/>
                </tree>

            </field>
        </record>
    </data>
</odoo>