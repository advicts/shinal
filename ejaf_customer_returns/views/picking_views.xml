<?xml version="1.0"?>
<odoo>
	<data>

		<record id="view_picking_form" model="ir.ui.view">
			<field name="name">stock.picking.form.inherit</field>
			<field name="model">stock.picking</field>
			<field name="inherit_id" ref="stock.view_picking_form" />
			 <field name="mode">primary</field>
            <field name="priority">1000</field>
			<field name="arch" type="xml">

				<xpath expr="//div[@class='oe_button_box']" position="inside">
				    <field name="credit_note_id" invisible='1'/>
				    <field name="is_customer_return" invisible='1'/>
                    <button type="object" name="action_view_refund_invoice" string="Credit Notes"
                            attrs="{'invisible':[('credit_note_id','=',False)]}"  class="oe_stat_button" icon="fa-money" />
                </xpath>

				<xpath expr="//button[@name='button_validate'][hasclass('o_btn_validate')]" position="after">
					<button name="create_refund_invoice" class="oe_highlight"
							attrs="{'invisible': ['|','|',('state', '!=', 'done'),('credit_note_id','!=',False),('is_customer_return','=', False)]}"
							string="Create Credit Note" type="object"/>
				</xpath>
				<xpath expr="//field[@name='partner_id']" position="attributes">
					<attribute name="domain">[('customer_rank', '>', 0)]</attribute>
				</xpath>
				<xpath expr="//field[@name='date_done']" position="after">
						<field name="currency_id" required="1" attrs="{'invisible': ['|','|',('state', '!=', 'done'),('credit_note_id','!=',False),('is_customer_return','=', False)]}"></field>
				</xpath>
			<xpath expr="//field[@name='picking_type_id']" position="attributes">
				<attribute name="domain">[('code', '=', 'incoming')]</attribute>
			</xpath>


			</field>
		</record>

		<record id="menu_customer_returns_actions" model="ir.actions.act_window">
		    <field name="name">Customer Returns</field>
		    <field name="type">ir.actions.act_window</field>
		    <field name="res_model">stock.picking</field>
		    <field name="view_mode">tree,form</field>
			<field name="context">{"default_is_customer_return": True, "is_customer_return": True}</field>
            <field name="domain">[('is_customer_return','=',True)]</field>
			 <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('stock.vpicktree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('view_picking_form')}),
                          ]"/>
		    <field name="help" type="html">
		      <p class="oe_view_nocontent_create">
		        <!-- Add Text Here -->
		      </p><p>
		        <!-- More details about what a user can do with this object will be OK -->
		      </p>
		    </field>
		</record>

		<menuitem id="menu_returns_categ" name="Returns" parent="stock.menu_stock_root" sequence="10"/>
		<menuitem id="menu_customer_returns" name="Customer Returns"
				  parent="menu_returns_categ" action="menu_customer_returns_actions" sequence="1"/>

	</data>
</odoo>