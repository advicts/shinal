<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.stock.account</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <div id="production_lot_info" position="after">
                    <h2>Customer Returns</h2>
                    <div class="row mt16 o_settings_container" name="customer_return_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box"
                            id="customer_return_price_type">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="customer_return_price_type"/>
                                <field name="customer_return_price_type"/>
                                <div class="text-muted">
                                   Choose the way to compute default price for customer return
                                </div>
                                <div class="content-group">
                                    <div name="landed_cost_info"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
