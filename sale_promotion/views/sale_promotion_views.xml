<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <data>
    <record id="sale_promotion_tree_views" model="ir.ui.view">
      <field name="name">sale.promotion</field>
      <field name="model">sale.promotion</field>
      <field name="arch" type="xml">
        <tree string="Sale Promotion">
          <field name="name" />
          <field name="analytic_tag_id" />
          <field name="start_at" />
          <field name="end_at" />
          <field name="state" />
        </tree>
      </field>
    </record>
    <!-- promotion Form view  -->
    <record model="ir.ui.view" id="sale_promotion_form_views">
      <field name="name">sale.promotion</field>
      <field name="model">sale.promotion</field>
      <field name="arch" type="xml">
        <form string="Promotion">
          <header>
            <button
              name="action_confirm"
              string="Confirm"
              class="oe_highlight"
              type="object"
              attrs="{'invisible': [('state', '!=', 'draft')]}"
            />
            <button
              name="action_close"
              string="Close"
              type="object"
              attrs="{'invisible': [('state', '!=', 'running')]}"
            />
            <field name="state" widget="statusbar" statusbar_visible="draft,running,closed" />
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box" />

            <div class="oe_title">
              <h1 class="d-flex">
                <field name="name" placeholder="Name" required="True" />
              </h1>
            </div>
            <group>
              <group>
                <field name="start_at" />
              </group>
              <group>
                <field name="end_at" />
              </group>
            </group>
            <group>
              <group>
                <field name="analytic_tag_id" />
              </group>
              <group>
                  <field name="default_currency_id" />
              </group>
            </group>
            <group>
                        <field name="description"/>

            </group>
            <group>
              <group name="user_rule" string="Users Rule">
                <field name="users_rule_based_on" string="Based on" widget="radio" />
                <field
                  name="specific_team_ids"
                  widget="many2many_tags"
                  attrs="{'invisible':[('users_rule_based_on','!=','specific_teams')],'required':[('users_rule_based_on','=','specific_teams')]}"
                />
                <field
                  name="specific_user_ids"
                  widget="many2many_tags"
                  attrs="{'invisible':[('users_rule_based_on','!=','specific_user')],'required':[('users_rule_based_on','=','specific_user')]}"
                />
              </group>
              <group name="partner_rule" string="customers Rule">
                <field name="partner_rule_based_on" string="Based on" widget="radio" />
                <field
                  name="customer_category_ids"
                  widget="many2many_tags"
                  attrs="{'invisible':[('partner_rule_based_on','!=','specific_customer_category')],'required':[('partner_rule_based_on','=','specific_customer_category')]}"
                />
              </group>
              <group name="product_rule" string="Products Rule">
                <field name="product_rule_based_on" string="Based on" widget="radio" />
                <field
                  name="specific_categ_ids"
                  widget="many2many_tags"
                  attrs="{'invisible':[('product_rule_based_on','!=','specific_product_category')],'required':[('product_rule_based_on','=','specific_product_category')]}"
                />
                <field
                  name="specific_product_temp_ids"
                  widget="many2many_tags"
                  attrs="{'invisible':[('product_rule_based_on','!=','specific_product_templates')],'required':[('product_rule_based_on','=','specific_product_templates')]}"
                />
                <field
                  name="specific_product_ids"
                  widget="many2many_tags"
                  attrs="{'invisible':[('product_rule_based_on','!=','specific_product')],'required':[('product_rule_based_on','=','specific_product')]}"
                />
              </group>
            </group>
            <group>
              <group>
                <field name="applied_on" widget="radio" options="{'horizontal': true}" />
                <field
                  name="global_discount_product_id"
                  attrs="{'invisible':[('applied_on','!=','total_order')],'required':[('applied_on','=','total_order')]}"
                />
                <field
                  name="min_amount"
                  attrs="{'invisible':[('applied_on','!=','total_order')],'required':[('applied_on','=','total_order')]}"
                />
                <field
                  name="min_quantity"
                  class="oe_inline"
                  attrs="{'invisible':[('applied_on','!=','order_lines')],'required':[('applied_on','=','order_lines')]}"
                />
                <field
                  name="reward_by"
                  widget="radio"
                  options="{'horizontal': true}"
                  attrs="{'invisible':[('applied_on','!=','order_lines')],'required':[('applied_on','=','order_lines')]}"
                />
              </group>
              <group
                string="Discount"
                attrs="{'invisible':['|',('reward_by','=','discount_lines'),('reward_by','=','reward_product')]}">
                <label string="Apply Discount" for="discount_type" />
                <div>
                  <field name="discount_type" class="oe_inline" />
                  <field
                    name="discount_percentage"
                    attrs="{'invisible': [('discount_type', '!=', 'percentage')],'required': [('discount_type', '=', 'percentage')]}"
                    class="oe_inline"
                  />
                  <span
                    attrs="{'invisible': [('discount_type', '!=', 'percentage')],'required': [('discount_type', '=', 'percentage')]}"
                    class="oe_inline">
                    %
                  </span>
                </div>
                <label
                  string="Fixed Amount"
                  for="discount_fixed_amount"
                  attrs="{'invisible': [('discount_type', '!=', 'fixed_amount')]}"
                />
                <div attrs="{'invisible': [('discount_type', '!=', 'fixed_amount')]}">
                  <field
                    name="discount_fixed_amount"
                    class="oe_inline"
                    attrs="{'required':[('discount_type', '=', 'fixed_amount')]}"
                    widget='monetary'
                    options="{'currency_field': 'currency_id'}"
                  />
                </div>
              </group>
            </group>

            <group attrs="{'invisible':[('reward_by','!=','discount_lines')]}">
              <field name="product_discounts_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle" />
                  <field name="discount_type" />
                  <field name="amount" />
                </tree>
              </field>
            </group>
            <group attrs="{'invisible':[('reward_by','!=','reward_product')]}">
              <field name="product_rewards_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle" />
                  <field name="product_id" />
                  <field name="qty" />
                  <field name="product_uom_id" />
                </tree>
              </field>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record model="ir.actions.act_window" id="sale_promotion_action">
      <field name="name">Promotions</field>
      <field name="res_model">sale.promotion</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="sale_promotion_tree_views" />
    </record>
    <menuitem
      name="Promotions"
      id="sale_promotion_menu"
      groups="base.group_user"
      action="sale_promotion_action"
      parent="sale.product_menu_catalog"
      sequence="100"
    />
  </data>
</odoo>
