<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="free_product_sequence" model="ir.sequence">
            <field name="name">Free Product Seq</field>
            <field name="code">stock.scrap.free</field>
            <field name="prefix">FP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stock_scrap_form_view_inherit" model="ir.ui.view">
            <field name="name">stock.scrap.form.view.inherit</field>
            <field name="model">stock.scrap</field>
            <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="free_product" invisible='1'/>
                </xpath>
                <xpath expr="//field[@name='scrap_location_id']" position="attributes">
                    <attribute name="attrs">{'invisible':[('free_product','=',True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='scrap_location_id']" position="after">
                    <field name="free_product_location_id"
                           attrs="{'invisible':[('free_product','=',False)],'required':[('free_product','=',True)]}"
                           options="{'no_create': True, 'no_open': True}"
                           groups="stock.group_stock_multi_locations" force_save="1"/>
                </xpath>
            </field>
        </record>
        <record model="ir.actions.act_window" id="stock.action_stock_scrap">
            <field name="context">{'default_free_product':False}</field>
            <field name="domain">[('free_product','=',False)]</field>
        </record>
        <record model="ir.actions.act_window" id="action_free_products">
            <field name="name">Free Products</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.scrap</field>
            <field name="view_mode">tree,form,kanban,pivot,graph</field>
            <field name="context">{'default_free_product':True}</field>
            <field name="domain">[('free_product','=',True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Free Products
                </p>
            </field>
        </record>


        <menuitem
                id="menu_free_product"
                name="Free Products"
                parent="stock.menu_stock_warehouse_mgmt"
                action="action_free_products"
                sequence="99"/>


    </data>
</odoo>