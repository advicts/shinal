<odoo>
  <data>
    <record id="visits_planning_tree" model="ir.ui.view">
      <field name="name">visits.planning</field>
      <field name="model">visits.planning</field>
      <field name="arch" type="xml">
        <tree
          string="Visits Planning"
          decoration-success="state=='confirmed'"
          decoration-danger="state=='canceled'"
          decoration-info="state=='draft'">
          <field name="name" />
          <field name="salesperson_id" />
          <field name="planning_by" />
          <field name="start_date" />
          <field name="end_date" />
          <field name="state" />
        </tree>
      </field>
    </record>
    <!-- visits planning form view defination-->
    <record model="ir.ui.view" id="visits_planning_form">
      <field name="name">visits.planning.form</field>
      <field name="model">visits.planning</field>
      <field name="arch" type="xml">
        <form string="Visits Planning">
          <header>
            <button
              name="action_populated"
              states="confirmed"
              type="object"
              string="Generate Visits"
            />
            <button name="action_confirmed" states="draft" type="object" string="Confirm" />
            <button
              name="action_canceled"
              states="confirmed,generated,draft"
              type="object"
              string="Cancel"
            />
            <field
              name="state"
              widget="statusbar"
              statusbar_visible="draft,confirmed,populated,canceled"
            />
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button
                name="action_view_visits"
                type="object"
                class="oe_stat_button"
                icon="fa-pencil-square-o">
                <field name="visits_ids" widget="statinfo" string="Visits" />
              </button>
            </div>

            <group>
              <group>
                <field name="name" />
                <field name="planning_by" required="1" widget="radio" />
                <field
                  name="salesperson_id"
                  attrs="{'invisible': [('planning_by', '!=', 'sales_person')],'required': [('planning_by', '=', 'sales_person')]}"
                />
              </group>
              <group string="Period">
                <field
                  name="start_date"
                  widget="daterange"
                  options="{'related_end_date': 'end_date'}"
                />
                <field
                  name="end_date"
                  widget="daterange"
                  options="{'related_start_date': 'start_date'}"
                />
              </group>
            </group>
          </sheet>
          <!-- Start Tracker  -->
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="message_ids" widget="mail_thread" />
          </div>
          <!-- End Tracker  -->
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="action_visits_planning">
      <field name="name">Visits Planning</field>
      <field name="res_model">visits.planning</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="visits_planning_tree" />
    </record>
    <menuitem
      id="vansales_visits_visit_menu"
      groups="sales_team.group_sale_manager"
      name="Visits"
      parent="vansales.vansales_menu"
      sequence="2"
    />

    <menuitem
      id="visits_planning"
      groups="sales_team.group_sale_manager"
      action="action_visits_planning"
      name="Planning Visits"
      parent="vansales_visits_visit_menu"
      sequence="1"
    />
  </data>
</odoo>
