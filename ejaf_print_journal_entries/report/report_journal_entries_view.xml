<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <template id="journal_entry_template_report_view">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page">
                    <br/>
                    <br/>
                    <div class="oe_structure"/>
                    <div>
                        <h3 class="text-center mb32">
                            <strong>Journal Entry</strong>
                        </h3>
                    </div>
                    <br/>

                    <div class="row" id="journal_information">
                        <div class="col-8">
                            <div>
                                <strong>Journal Entry :</strong>
                                <p t-field="o.name"/>
                            </div>

                            <div class="text-left">
                                <strong>Date :</strong>
                                <p t-field="o.date"/>
                            </div>
                        </div>

                        <div class="col-8">
                            <div>
                                <strong>Journal :</strong>
                                <p t-field="o.journal_id"/>
                            </div>
                            <div class="text-left">
                                <strong>Reference :</strong>
                                <p t-field="o.ref"/>
                            </div>

                        </div>
                    </div>


                    <br/>
                    <br/>
                    <table style="border-collapse: collapse;width: 100%;" class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Partner</th>
                                <th>Account</th>
                                <th>Label</th>
                                <th>Due Date</th>
                                <th>Analytic Account</th>
                                <th>Taxes(%)</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Amount Currency</th>
                            </tr>
                        </thead>
                        <tbody class="consumed_tbody">
                            <t t-set="total" t-value="0.0"/>
                            <t t-set="total1" t-value="0.0"/>
                            <t t-set="total2" t-value="0.0"/>
                            <t t-foreach="o.line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.partner_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.account_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.date_maturity"/>
                                    </td>
                                    <td>
                                        <span t-field="line.analytic_account_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.tax_ids"/>
                                    </td>
                                    <td>
                                        <span t-field="line.debit"/>
                                    </td>
                                    <td>
                                        <span t-field="line.credit"/>
                                    </td>
                                    <td>
                                        <span t-if="line.amount_currency" t-field="line.amount_currency"
                                              t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-set="total" t-value="total + line.debit"/>
                                <t t-set="total1" t-value="total1 + line.credit"/>
                                <t t-set="total2" t-value="total1 + line.amount_currency"/>
                            </t>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>
                                    <strong>Total:</strong>
                                </td>
                                <td width="10%">
                                    <strong>
                                        <span>
                                            <t t-esc="total"/>
                                        </span>
                                    </strong>
                                </td>
                                <td width="10%">
                                    <strong>
                                        <span>
                                            <t t-esc="total1"/>
                                        </span>
                                    </strong>
                                </td>
                                <td width="10%">
                                    <strong>
                                        <span>
                                            <t t-esc="total2"/>
                                        </span>
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <br></br>
                    <br></br>
                    <div class="text-right">
                        <strong>اسم المستلم</strong>
                    </div>


                </div>
            </t>
        </template>

        <template id="journal_entry_report_template_id">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="ejaf_print_journal_entries.journal_entry_template_report_view"
                       t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
