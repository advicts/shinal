<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="partner_label">
            <div class="page">
                <center>
                    <table  t-if="user.lang!='ar_SY'" width="100%;" style="font-size:20px;page-break-inside: avoid;border-top: 5px solid #ECDE1A;border-bottom: 5px solid #ECDE1A;line-height: 1.4">



                            <td  width="65%;"  >
                                <div style="text-align:right;font-weight:bold">
                                <br></br>
                                   <strong style="color:#FFFFFF" t-esc="user.company_id.display_name" />
                                <strong style="color:#FFFFFF">___</strong>
                                </div>
                                                                <br></br>

                                <p style="text-align:left;font-weight:bold">
                                  Name:  <strong t-field="doc.name"/>
                                </p>

                                <p style="text-align:left;font-weight:bold" >
                                  address:  <strong t-field="doc.street"/>
                                  <strong t-field="doc.city"/>
                                </p>

                               <p style="text-align:left;font-weight:bold">
                                  Mobil:  <strong  dir="ltr" t-field="doc.mobile"/>
                               </p>
                               <p style="text-align:left;font-weight:bold" >
                                  Collection Center:  <strong t-field="doc.collection_center_id.name"/>
                               </p>

                               <p style="text-align:left;font-weight:bold">
                                  Code :  <strong t-field="doc.partner_ref"/>
                               </p>
                               <br></br>
                                                            <strong style="color:#FFFFFF">___</strong>


                            </td>
                               <td  class="text-center" style="padding-top:10px;"  width="35%">
                                <img t-att-src="image_data_uri(user.company_id.logo)" style="max-height:90pt;max-width:100%" alt="logo"/>
                                <br></br>
                                <br></br>
                                <br></br>
                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR',str({'id':doc.id,'name':doc.name,'phone':str(doc.phone),'mobile':str(doc.mobile)}), 650, 100)" style="width:125px;height:125px;" />
                            </td>


                    </table>
                     <table t-if="user.lang == 'ar_SY'"  dir="rtl" width="100%;" style="font-size:20px;page-break-inside: avoid;border-top: 5px solid #ECDE1A;border-bottom: 5px solid #ECDE1A;line-height: 1.4">

                           <td  width="65%;" style="font-weight:bold" >
                                <div style="text-align:left;font-weight:bold">
                                <br></br>
                                   <strong style="color:#FFFFFF" t-esc="user.company_id.display_name"/>
                                <strong style="color:#FFFFFF">___</strong>
                                </div>
                                                                <br></br>

                                <p style="text-align:right;font-weight:bold">
                                  ناو:  <strong t-field="doc.name"/>
                                </p>
                                <p  dir="rtl" style="text-align:right;font-weight:bold">
                                  ناونيشان:  <strong t-field="doc.street"/>
                                  <strong t-field="doc.city"/>
                                </p>

                               <p style="text-align:right;font-weight:bold">
                                  ژماره‌ی مۆبایل:  <strong dir="ltr" t-field="doc.mobile"/>
                               </p>

                               <p style="text-align:right;font-weight:bold">
                                  بنكه :  <strong t-field="doc.collection_center_id.name"/>
                               </p>

                               <p style="text-align:right;font-weight:bold">
                                  کۆد :  <strong t-field="doc.partner_ref"/>
                               </p>

                           <br></br>
                                                           <strong style="color:#FFFFFF">___</strong>

                            </td>

                           <td class="text-center" style="padding-top:10px;"  width="35%">
                                <img t-att-src="image_data_uri(user.company_id.logo)" style="max-height:90pt;max-width:100%" alt="logo"/>
                                <br></br>
                                <br></br>
                                <br></br>

                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR',str({'id':doc.id,'name':doc.name,'phone':str(doc.phone),'mobile':str(doc.mobile)}), 650, 100)" style="width:125px;height:125px;" />
                            </td>


                    </table>
                    <p style="page-break-after:always;">   </p>

                </center>
            </div>
        </template>
        <template id="partner_label_d">

            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="o" t-value="doc"/>

                    <t t-call="ejaf_partner_label.partner_label">

                    </t>
                </t>
            </t>
        </template>
        <report id="report_partner_label" string="partner Card (PDF)" model="res.partner" report_type="qweb-pdf"
                name="ejaf_partner_label.partner_label_d" file="ejaf_partner_label.partner_label_d"

        />

        <record id="ejaf_partner_label.report_partner_label" model="ir.actions.report">
            <field name="paperformat_id" ref="ejaf_partner_label.partner_badge_paperformat"/>
        </record>

    </data>
</odoo>
