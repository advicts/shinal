<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.view.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="before">
                    <field name="qty_of_scrap" invisible="1"/>
                    <field name="sale_order_partner_id"
                           attrs="{'readonly': [('state', '!=', 'draft')]}"
                           widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer'}"/>
                </xpath>
            </field>
        </record>

        <record id="mrp_production_tree_view_inherit" model="ir.ui.view">
            <field name="name">mrp.production.tree.view.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="before">
                    <field name="sale_order_partner_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="mrp_production_filter_inherit" model="ir.ui.view">
            <field name="name">mrp.production.filter.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="sale_order_partner_id"/>
                </xpath>

                <xpath expr="//filter[@name='product']" position="after">
                    <filter string="Customer" name="customer" domain="[]"
                            context="{'group_by': 'sale_order_partner_id'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
