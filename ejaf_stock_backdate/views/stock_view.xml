<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_quant_list_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.list.view.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <field name="lot_id" position="after">
                    <field name="production_date" optional="show" force_save="1"/>
                    <field name="expiration_date" optional="show" force_save="1"/>
                </field>
            </field>
        </record>
        <record id="report_stock_quant_list_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.list.view.report.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//field[last()]" position="after">
                    <field name="production_date" optional="show" force_save="1"/>
                    <field name="expiration_date" optional="show" force_save="1"/>
                </xpath>
            </field>
        </record>
        <record id="stock_quant_list_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.list.view.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <field name="inventory_date" position="after">
                    <field name="force_inventory_date" optional="show" force_save="1" invisible="1"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
