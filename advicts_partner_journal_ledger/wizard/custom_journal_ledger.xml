<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="custom_journal_ledger_form" model="ir.ui.view">
        <field name="name">custom.journal.ledger.form</field>
        <field name="model">custom.journal.ledger</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="custom_currency_id"/>
                        </group> 
                    </group>
                    <notebook>
                        <page string="journals">
                            <field name="journal_ids" no_label="1">
                                <tree>
                                    <field name="display_name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button id="button_print" type="object" name="print_report_action" string="Print" class='btn-primary'/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="custom_journal_ledger_wizard_action" model="ir.actions.act_window">
        <field name="name">custom journal Ledger</field>
        <field name="res_model">custom.journal.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="custom_journal_ledger_form"/>
        <field name="target">new</field>
    </record>

</odoo>
