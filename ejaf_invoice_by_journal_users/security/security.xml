<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="access_config_accounting_group" model="res.groups">
            <field name="name">Account: Access Configuration</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        </record>
        <record id="restricted_journal_group" model="res.groups">
            <field name="name">Limited Access By Journals</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        </record>
        <record id="all_journals_group" model="res.groups">
            <field name="name">All Journals</field>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        </record>
        <record id="restricted_journals_rule" model="ir.rule">
            <field name="name">Restricted Journals Rule</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('ejaf_invoice_by_journal_users.restricted_journal_group'))]"/>
        </record>
        <record id="all_journals_rule" model="ir.rule">
            <field name="name">All Journals Rule</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="domain_force">[(1, '=', 1)]
            </field>
            <field name="groups" eval="[(4, ref('ejaf_invoice_by_journal_users.all_journals_group'))]"/>
        </record>
        <record id="sale.account_invoice_rule_see_personal" model="ir.rule">
            <field name="active">False</field>
        </record>
        <record id="account.account_move_rule_group_invoice" model="ir.rule">
            <field name="active">False</field>
        </record>
        <record id="account.account_move_rule_group_readonly" model="ir.rule">
            <field name="active">False</field>
        </record>
        <record id="account.account_move_see_all" model="ir.rule">
            <field name="active">False</field>
        </record>
        <record id="restricted_journal_entries_rule" model="ir.rule">
            <field name="name">Restricted Journal Entries Rule</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('journal_id.user_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('ejaf_invoice_by_journal_users.restricted_journal_group'))]"/>
        </record>
        <record id="all_journal_entries_rule" model="ir.rule">
            <field name="name">All Journal Entries Rule</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[(1, '=', 1)]
            </field>
            <field name="groups" eval="[(4, ref('ejaf_invoice_by_journal_users.all_journals_group'))]"/>
        </record>
    </data>
</odoo>