<odoo>
    <data>
      <record id="scrap_multi_product_tree" model="ir.ui.view">
        <field name="name">scrap_multi_product_tree</field>
        <field name="model">scrap.multi.product</field>
        <field name="arch" type="xml">
          <tree>
            <field name="name" />
            <field name="location_id" />
            <field name="scrap_location_id" />
          </tree>
        </field>
      </record>
  
      <record model="ir.ui.view" id="scrap_multi_product_form">
        <field name="name">scrap_multi_product.form</field>
        <field name="model">scrap.multi.product</field>
        <field name="arch" type="xml">
          <form string="Visits">
            <header>
              <button name="action_confirmed" states="draft" type="object" string="Confirm" />
              <button name="action_validate" states="confirm" type="object" string="validate" /> 
              <field
                name="state"
                widget="statusbar"
              />
            </header>
            <sheet>
              <div class="oe_button_box" name="button_box">
                <button attrs="{'invisible':[('stock_scrap_ids', '=', [])]}"
                  name="action_view_scrap"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-pencil-square-o">
                  <field name="stock_scrap_ids" widget="statinfo" string="Scraps" />
                </button>
              </div>
  
                <group>
                    <field name="name" attrs="{'readonly':[('state', '!=', 'draft')]}"  />
                </group>
              <group>
                <group>
                  <field name="available_product_ids" invisible="1"/>
                  <field name="available_quant_ids" invisible="1"/>
                  <field name="location_id" domain="[('usage','=','internal')]" force_save="1" attrs="{'readonly':['|',('line_ids','!=',[]),('state', '!=', 'draft')]}"   options="{'no_create': True, 'no_open': True}"/>
                </group>
                <group>
                     <field name="scrap_location_id" domain="[('scrap_location','=',True)]" attrs="{'readonly':[('state', '!=', 'draft')]}"  options="{'no_create': True, 'no_open': True}"/>
                  </group>
              </group>
              <notebook>
                <page string="Scrap Lines">
                    <field name="line_ids" attrs="{'readonly':[('state', '!=', 'draft')]}" >
                        <tree editable="bottom">
                            <field name="product_id" domain="[('id','in',parent.available_product_ids)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="scrap_qty"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_uom_id" options="{'no_create': True, 'no_open': True}" domain="[('category_id','=',product_uom_category_id)]"/>
                            <field name="tracking" invisible="1"/>
                            <field name="lot_id" options="{'no_create': True, 'no_open': True}" attrs="{'required': [('tracking', '!=', 'none')]}" groups="stock.group_production_lot" domain="[('product_id', '=', product_id),('quant_ids','in',parent.available_quant_ids)]"/>
                        </tree>
                    </field>
                </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
              <field name="message_follower_ids"/>
              <field name="activity_ids"/>
              <field name="message_ids"/>
          </div>
          </form>
        </field>
      </record>
  
      <record model="ir.actions.act_window" id="action_scrap_multi_product">
        <field name="name">Scrap Multi Product</field>
        <field name="res_model">scrap.multi.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="scrap_multi_product_tree" />
      </record>
  
      <menuitem
        name="Scrap Multi Product"
        id="scrap_multi_product_menu"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_scrap_multi_product"
        sequence="98"
      />
    </data>
  </odoo>
  