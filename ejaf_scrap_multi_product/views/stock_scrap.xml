<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="stock_scrap_form_view_inherit" model="ir.ui.view">
            <field name="name">stock.scrap.form.view.inherit</field>
            <field name="model">stock.scrap</field>
            <field name="inherit_id" ref="stock.stock_scrap_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="scrap_multi_product_id" string="Source Multi Scrap" attrs="{'invisible': [('scrap_multi_product_id', '=', False)]}"/>
                </xpath>
                
            </field>
        </record>
  

    </data>
</odoo>