<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_cron_send_low_stock_to_first_level" model="ir.cron">
            <field name="name">Check Stock Quantity and Send Notification To First Level</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.send_product_minimum_qty_first_level_notify()</field>
        </record>
        <record id="ir_cron_send_low_stock_to_second_level" model="ir.cron">
            <field name="name">Check Stock Quantity and Send Notification To Second Level</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="state">code</field>
            <field name="code">model.send_product_minimum_qty_second_level_notify()</field>
        </record>
    </data>

</odoo>