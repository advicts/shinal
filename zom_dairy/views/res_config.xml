<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
      <field name="arch" type="xml">
      <xpath expr="//div[hasclass('settings')]" position="inside">
                <div id="invite_users">
                    <h2>Zom App Url</h2>
                    <div class="row mt16 o_settings_container" name="users_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="zom_app_url">
                            <div class="o_setting_right_pane">
                            <label string="Zom App Url" for="zom_app_url" class="col-lg-3 o_light_label"/>
                                <field name="zom_app_url"/>
                            </div>
                        </div>  
                    </div>
                </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
