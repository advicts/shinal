<odoo>
  <data>
    <record id="collection_center_tree" model="ir.ui.view">
      <field name="name">Collection Center</field>
      <field name="model">collection.center</field>
      <field name="arch" type="xml">
        <tree string="Collection Center">
          <field name="code" />
          <field name="name" />
        </tree>
      </field>
    </record>
    <record model="ir.ui.view" id="collection_center_form">
      <field name="name">Collection Center</field>
      <field name="model">collection.center</field>
      <field name="arch" type="xml">
        <form string="Collection Center">

          <sheet>
            <div class="oe_button_box" name="button_box">
     
              <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                <field name="payment_ids" widget="statinfo" string="Payments" />
              </button>
              <button name="action_view_purchase_order" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                <field name="po_ids" widget="statinfo" string="Purchase Orders" />
              </button>

              <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-check">
                <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;active&quot;}" />
              </button>
            </div>
            <group>
              <group>
                <field name="code" />
                <field name="name" />
              </group>
              <group>
                <field name="receive_milk_operation_type_id" />
                <field name="receive_milk_driver_operation_type_id" widget="many2many_tags"  />
                <field name="product_ids" widget="many2many_tags" />
              </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="message_ids" widget="mail_thread" />
          </div>
        </form>
      </field>
    </record>
    <record model="ir.actions.act_window" id="action_collection_center">
      <field name="name">Collection Center</field>
      <field name="res_model">collection.center</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="collection_center_tree" />
    </record>
  </data>
</odoo>