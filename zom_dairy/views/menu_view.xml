        <menuitem id="zom_payments" groups="zom_dairy.access_zom_module_group_manger" action="zom_payments_action"
                  name="Payments" parent="zom_dairy_menu" sequence="2"/>
        <menuitem id="zom_transfers" groups="zom_dairy.access_zom_module_group_user" action="zom_stock_picking_action"
                  name="Transfers" parent="zom_dairy_menu" sequence="3"/>
        <menuitem id="action_partner_zone_menu" action="action_partner_zone_view" name="Partner Zone"
                  parent="purchase.menu_purchase_config" sequence="3"/>


        <!-- Purchase Menus   -->
        <menuitem name="Purchase"
                  groups="purchase.group_purchase_user"
                  id="zom_dairy_purchase_menu_p"
                  parent="purchase.menu_purchase_root"
                  sequence="1"/>

        <menuitem id="zom_dairy_external_purchase_order_menu_p"
                  groups="purchase.group_purchase_user"
                  action="zom_dairy_external_purchase_order_action"
                  name="External Purchase"
