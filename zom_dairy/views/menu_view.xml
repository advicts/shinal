                  sequence="1"/>

        <menuitem id="zom_dairy_internal_purchase_order_menu_p"
                  groups="purchase.group_purchase_user"
                  action="zom_dairy_internal_purchase_order_action"
                  name="Internal Purchase"
                  parent="zom_dairy_purchase_menu_p"
                  sequence="2"/>

        <menuitem id="scan_zom_dairy_internal_purchase_order_menu_p"
                  groups="purchase.group_purchase_user"
                  action="purchase_order_find"
                  name="Find Purchase"
                  parent="zom_dairy_purchase_menu_p"
                  sequence="3"/>

    </data>
</odoo>