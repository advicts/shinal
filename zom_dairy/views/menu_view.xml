            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>


        <record id="zom_payments_action" model="ir.actions.act_window">
            <field name="name">Payments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.payment</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="domain">[('is_zom_app','=',True)]</field>
            <field name="context">{"default_is_zom_app": True, "is_zom_app": True}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>


        <record id="zom_stock_picking_action" model="ir.actions.act_window">
            <field name="name">Transfers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_zom_app','=',True)]</field>
            <field name="context">{"default_is_zom_app": True, "is_zom_app": True}</field>
