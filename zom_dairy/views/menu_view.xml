                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <menuitem name="Zom Dairy" groups="zom_dairy.access_zom_module_group_user" id="zom_dairy_menu" sequence="30"
                  web_icon="zom_dairy,static/description/icon.png"/>
        <menuitem name="Configuration" groups="zom_dairy.access_zom_module_group_manger"
                  id="zom_dairy_configuration_menu" parent="zom_dairy_menu" sequence="30"/>
        <menuitem id="res_users_zom_dairy_menu" groups="zom_dairy.access_zom_module_group_manger"
                  action="action_res_users_zom_dairy" name="Settings" parent="zom_dairy_configuration_menu"
                  sequence="12"/>
        <menuitem id="collection_center_menu" groups="zom_dairy.access_zom_module_group_manger"
                  action="action_collection_center" name="Collection Center" parent="zom_dairy_configuration_menu"
                  sequence="10"/>
        <menuitem name="Purchase" groups="zom_dairy.access_zom_module_group_user" id="zom_dairy_purchase_menu"
                  parent="zom_dairy_menu" sequence="1"/>
        <menuitem id="zom_dairy_external_purchase_order_menu" groups="zom_dairy.access_zom_module_group_user"
                  action="zom_dairy_external_purchase_order_action" name="External Purchase"
                  parent="zom_dairy_purchase_menu" sequence="1"/>
        <menuitem id="zom_dairy_internal_purchase_order_menu" groups="zom_dairy.access_zom_module_group_user"
                  action="zom_dairy_internal_purchase_order_action" name="Internal Purchase"
                  parent="zom_dairy_purchase_menu" sequence="2"/>
        <menuitem id="scan_zom_dairy_internal_purchase_order_menu" groups="zom_dairy.access_zom_module_group_user"
