        <!-- model.name action window -->
        <record id="zom_dairy_external_purchase_order_action" model="ir.actions.act_window">
            <field name="name">External Purchase Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="domain">[('is_external_purchase_order','=',True)]</field>
            <field name="context">{"default_is_external_purchase_order": True, "is_external_purchase_order": True}
            </field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <record id="zom_dairy_internal_purchase_order_action" model="ir.actions.act_window">
            <field name="name">Internal Purchase Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="domain">[('is_external_purchase_order','=',False)]</field>
            <field name="context">{"default_is_external_purchase_order": False,"default_is_internal_purchase_order": True, "is_external_purchase_order": False, "is_internal_purchase_order": True}
