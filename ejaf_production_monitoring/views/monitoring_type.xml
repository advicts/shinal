<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="production_monitoring_team_kanban_view" model="ir.ui.view">
            <field name="name">production.monitoring.team.kanban</field>
            <field name="model">monitoring.team</field>
            <field name="arch" type="xml">
                <kanban class="oe_background_grey o_kanban_dashboard " group_create="0" create="0">
                    <field name="name"/>
                    <field name="close_issue_count"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <field name="name"/>
                                    </div>
                                    <button class="btn btn-primary o_helpdesk_ticket_btn" name="action_view_p_m"
                                            type="object">Production Monitoring
                                    </button>
                                    <a name="action_view_p_m_close" type="object">
                                        Issues Closed
                                        <span style="color:#FFFFFF">-------</span>
                                        <field name="close_issue_count"/>

                                    </a>
                                </div>

                            </div>

                        </t>
                    </templates>
                </kanban>

            </field>
        </record>

        <record id="production_monitoring_team_form_view" model="ir.ui.view">
            <field name="name">production.monitoring.team.form</field>
            <field name="model">monitoring.team</field>
            <field name="arch" type="xml">
                <form string="Production Monitoring Type">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" text="Archived" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>

                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="production_monitoring_team_tree_view" model="ir.ui.view">
            <field name="name">production.monitoring.team.tree</field>
            <field name="model">monitoring.team</field>
            <field name="arch" type="xml">
                <tree string="Production Monitoring Type">

                    <field name="name"/>

                </tree>
            </field>
        </record>
        <record id="production_monitoring_team_action_view" model="ir.actions.act_window">
            <field name="name">Production Monitoring Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">monitoring.team</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>
        <record id="production_monitoring_team_action_over_view" model="ir.actions.act_window">
            <field name="name">Overview</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">monitoring.team</field>
            <field name="view_mode">kanban</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

    </data>
</odoo>

