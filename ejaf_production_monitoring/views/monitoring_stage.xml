<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="production_monitoring_stage_form_view" model="ir.ui.view">
            <field name="name">production.monitoring.stage.form</field>
            <field name="model">monitoring.stage</field>
            <field name="arch" type="xml">
                <form string="Production Monitoring Stages">

                    <sheet>
                        <div class="Name">
                            <h1>
                                <field name="name"
                                       placeholder="Name"

                                />
                            </h1>

                        </div>
                        <group>
                            <field name="is_first_stage"/>
                            <field name="is_final_stage"/>
                            <field name="types_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <group>
                                <field name="display_standardization"/>
                                <field name="display_homogenizer"/>
                                <field name="display_cream"/>
                                <field name="display_homogenizer_bar"/>
                                <field name="display_pasteurizer_temperature"/>
                                <field name="display_pasteurizer_flow"/>
                                <field name="display_evp_flow"/>
                                <field name="display_milk_inlet_temp"/>
                                <field name="display_total_milk"/>
                            </group>
                            <group>
                                <field name="display_brix"/>
                                <field name="display_type_of_ulture"/>
                                <field name="display_fermentation_temperature"/>
                                <field name="display_number_of_products"/>
                                <field name="display_heat_of_room"/>
                                <field name="display_rest_time"/>
                                <field name="display_cooling_degree"/>
                                <field name="display_cooling_hours"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="production_monitoring_stage_tree_view" model="ir.ui.view">
            <field name="name">production.monitoring.stage.tree</field>
            <field name="model">monitoring.stage</field>
            <field name="arch" type="xml">
                <tree string="Production Monitoring Stages">

                    <field name="name"/>

                </tree>
            </field>
        </record>
        <record id="production_monitoring_stage_action_view" model="ir.actions.act_window">
            <field name="name">Production Monitoring Stages</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">monitoring.stage</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

    </data>
</odoo>

