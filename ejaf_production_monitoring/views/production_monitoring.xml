<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model='ir.ui.view' id='production_monitoring_form_view2'>
            <field name="name">production.monitoring.form2</field>
            <field name="model">production.monitoring</field>
            <field name="arch" type="xml">
                <form string="Production Monitoring">

                    <sheet>
                        <group>
                            <field name="type_id"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>
        <record id="production_monitoring_kanban" model="ir.ui.view">
            <field name="name">production.monitoring.kanban</field>
            <field name="model">production.monitoring</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column"
                        sample="1" on_create="quick_create"
                        quick_create_view="ejaf_production_monitoring.production_monitoring_form_view2"
                        archivable="false">
                    <field name="name"/>
                    <field name="ref"/>
                    <field name="user_id"/>
                    <field name="product_id"/>
                    <field name="type_id"/>
                    <field name="quantity"/>
                    <field name="product_uom"/>
                    <field name="stage_id"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <span>
                                            <field name="name"/>
                                        </span>
                                        <br></br>
                                        <strong>Reference :</strong>
                                        <span>
                                            <field name="ref"/>
                                        </span>
                                    </strong>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown"
                                       data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <t t-if="widget.editable">
                                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                        </t>
                                        <t t-if="widget.deletable">
                                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </t>
                                    </div>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="user_id"/>
                                    </span>

                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <div class="o_kanban_inline_block">
                                            <strong>Type</strong>
                                            <field name="type_id"/>
                                        </div>
                                        <div class="o_kanban_inline_block">
                                            <strong>Product</strong>
                                            <field name="product_id"/>
                                        </div>
                                        <div class="o_kanban_inline_block">
                                            <strong>QTY</strong>
                                            <field name="quantity"/>
                                            <field name="product_uom"/>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="production_monitoring_form_view" model="ir.ui.view">
            <field name="name">production.monitoring.form</field>
            <field name="model">production.monitoring</field>
            <field name="arch" type="xml">
                <form string="Production Monitoring">
                    <header>
                        <field name="is_first_stage" invisible="1"/>
                        <field name="is_confirmed" invisible="1"/>
                        <button name="action_move_to_back_stage" type="object" class="btn-primary"
                                string="Previous Stage" attrs="{'invisible': ['|',('is_first_stage', '=', True),('is_final_stage', '=', True)]}"/>
                        <button name="action_move_to_next_stage" type="object" class="btn-primary" string="Next Stage"
                                attrs="{'invisible': [('is_final_stage', '=', True)]}"/>
                        <button name="action_confirm" type="object" class="btn-primary"
                                groups="ejaf_production_monitoring.production_monitoring_admin"
                                attrs="{'invisible': ['|',('is_confirmed', '=', True),('is_final_stage', '=', False)]}"
                                string="Confirm"/>
                        <field name="stage_id" widget="statusbar"


                        />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="open_mrp" type="object"
                                    icon="fa-wrench">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                    </span>
                                    <span class="o_stat_text">MO</span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" text="Confirmed" bg_color="bg-success"
                                attrs="{'invisible': [('is_confirmed', '=', False)]}"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" default_focus="1"
                                       placeholder="Name"
                                       readonly="1"
                                       force_save="1"
                                />
                            </h1>

                        </div>
                        <group>
                            <field name="ref" readonly="1" force_save="1"/>
                            <field name="user_id"
                                   readonly="1"/>
                            <field name="product_id"
                                   readonly="1"/>
                            <field name="company_id"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="date"
                                   readonly="1"/>
                            <field name="type_id"
                                   readonly="1"/>
                            <field name="quantity"
                                   readonly="1"/>
                            <field name="product_uom"
                                   readonly="1"/>
                            <field name="mo_id" invisible="1"/>
                            <field name="is_final_stage" invisible="1"/>
                            <field name="display_standardization" invisible="1"/>
                            <field name="display_homogenizer" invisible="1"/>
                            <field name="display_cream" invisible="1"/>
                            <field name="display_homogenizer_bar" invisible="1"/>
                            <field name="display_pasteurizer_temperature" invisible="1"/>
                            <field name="display_pasteurizer_flow" invisible="1"/>
                            <field name="display_evp_flow" invisible="1"/>
                            <field name="display_milk_inlet_temp" invisible="1"/>
                            <field name="display_total_milk" invisible="1"/>
                            <field name="display_brix" invisible="1"/>
                            <field name="display_type_of_ulture" invisible="1"/>
                            <field name="display_fermentation_temperature" invisible="1"/>
                            <field name="display_number_of_products" invisible="1"/>
                            <field name="display_heat_of_room" invisible="1"/>
                            <field name="display_rest_time" invisible="1"/>
                            <field name="display_cooling_degree" invisible="1"/>
                            <field name="display_cooling_hours" invisible="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="is_standardization"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_standardization', '=', False)]}"/>
                                <field name="homogenizer"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_homogenizer', '=', False)]}"/>
                                <field name="homogenizer_bar"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_homogenizer_bar', '=', False)]}"/>
                                <field name="cream"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_cream', '=', False)]}"/>
                                <field name="pasteurizer_temperature"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_pasteurizer_temperature', '=', False)]}"/>
                                <field name="pasteurizer_flow"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_pasteurizer_flow', '=', False)]}"/>
                                <field name="evp_flow"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_evp_flow', '=', False)]}"/>
                                <field name="milk_inlet_temp"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_milk_inlet_temp', '=', False)]}"/>
                                <field name="total_milk"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_total_milk', '=', False)]}"/>
                            </group>

                            <group>
                                <field name="brix"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_brix', '=', False)]}"/>
                                <field name="type_of_ulture"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_type_of_ulture', '=', False)]}"/>
                                <field name="fermentation_temperature"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_fermentation_temperature', '=', False)]}"/>
                                <field name="number_of_products"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_number_of_products', '=', False)]}"/>
                                <field name="heat_of_room"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_heat_of_room', '=', False)]}"/>
                                <field name="rest_time"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_rest_time', '=', False)]}"/>
                                <field name="cooling_degree"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_cooling_degree', '=', False)]}"/>
                                <field name="cooling_hours"
                                       attrs="{'readonly': [('is_final_stage', '=', True)], 'invisible': [('display_cooling_hours', '=', False)]}"/>
                            </group>

                        </group>
                        <field name="description" class="field_description"
                               placeholder="Description of the Monitoring..."
                               attrs="{'readonly': [('is_final_stage', '=', True)]}"/>

                    </sheet>
                </form>
            </field>
        </record>
        <record id="production_monitoring_tree_view" model="ir.ui.view">
            <field name="name">production.monitoring.tree</field>
            <field name="model">production.monitoring</field>
            <field name="arch" type="xml">
                <tree string="Production Monitoring">

                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="product_id"/>
                    <field name="type_id"/>
                    <field name="quantity"/>
                    <field name="product_uom"/>
                    <field name="stage_id" widget="badge"/>

                </tree>
            </field>
        </record>
        <record id="production_monitoring_action_view" model="ir.actions.act_window">
            <field name="name">Production Monitoring</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">production.monitoring</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                </p>
                <p>
                </p>
            </field>
        </record>

    </data>
</odoo>
