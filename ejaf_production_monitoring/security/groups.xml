<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="production_monitoring_categ" model="ir.module.category">
            <field name="name">Production Monitoring</field>
            <field name="sequence" eval="1"/>
        </record>
        <record id="production_monitoring_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="production_monitoring_categ"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="production_monitoring_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="production_monitoring_categ"/>
            <field name="implied_ids" eval="[(4, ref('production_monitoring_user'))]"/>
        </record>


    </data>
</odoo>