<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_restriction_manager_group" model="res.groups">
            <field name="name">Product Restriction Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="product_template_restriction_rule" model="ir.rule">
            <field name="name">Product Template Restriction Rule</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">
                [('id','in',user.allowed_product_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="product_product_restriction_rule" model="ir.rule">
            <field name="name">Product Restriction Rule</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">
                [('product_tmpl_id','in',user.allowed_product_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="product_template_restriction_rule_manager" model="ir.rule">
            <field name="name">Product Template Restriction Manager Rule</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">
                [(1,'=',1)]
            </field>
            <field name="groups" eval="[(4, ref('product_restriction_manager_group'))]"/>
        </record>
        <record id="product_product_restriction_rule_manager" model="ir.rule">
            <field name="name">Product Restriction Manager Rule</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="domain_force">
                [(1,'=',1)]
            </field>
            <field name="groups" eval="[(4, ref('product_restriction_manager_group'))]"/>
        </record>

        <record id="product_category_restriction_rule" model="ir.rule">
            <field name="name">Product Category Restriction Rule</field>
            <field name="model_id" ref="product.model_product_category"/>
            <field name="domain_force">
                [('id','in',user.allowed_product_category_ids.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="product_category_restriction_rule_manager" model="ir.rule">
            <field name="name">Product Category Restriction Manager Rule</field>
            <field name="model_id" ref="product.model_product_category"/>
            <field name="domain_force">
                [(1,'=',1)]
            </field>
            <field name="groups" eval="[(4, ref('product_restriction_manager_group'))]"/>
        </record>

    </data>
</odoo>