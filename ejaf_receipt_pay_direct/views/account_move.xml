<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_move_view_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.view.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field  name="move_payment_type"
                            attrs="{'invisible': [('move_type', 'not in', ['out_receipt', 'in_receipt'])], 'readonly': [('posted_before', '=', True)]}"/>
                </xpath>
                <xpath expr="//page[@id='aml_tab']" position="attributes">
                    <attribute  name="attrs">{'invisible': [('move_payment_type', 'in', ['direct']), ('state', 'in', ['draft'])]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>